SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
PORT="4000"
CORS_ORIGIN="http://localhost:8080,https://your-production-domain.com"
PUBLIC_SITE_URL="https://your-production-domain.com"

# Optional but required for queue-backed scheduling and social publishing.
REDIS_URL="redis://default:password@host:6379"

# Optional but required for file uploads.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="your-r2-bucket-name"
R2_PUBLIC_URL="https://cdn.your-production-domain.com"
FORM_UPLOAD_MAX_BYTES="10485760"
