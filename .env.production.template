# ─── Supabase (Frontend) ─────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ─── Supabase (Backend/Workers) ─────────────────
# Note: Use separate Service Role for workers to bypass RLS
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── Auth & Security ────────────────────────────
# Generate a 64-byte random string for JWT
JWT_SECRET=REPLACE_WITH_PRODUCTION_SECRET
JWT_EXPIRES_IN=7d

# AES-256-GCM encryption key for social tokens (64-char hex string)
SOCIAL_ENCRYPTION_KEY=REPLACE_WITH_PRODUCTION_ENCRYPTION_KEY

# ─── Upstash Redis (BullMQ) ─────────────────────
REDIS_URL=rediss://YOUR_UPSTASH_ENDPOINT:6380
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# ─── Cloudflare R2 ──────────────────────────────
R2_ACCOUNT_ID=YOUR_CF_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_KEY
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET
R2_BUCKET_NAME=YOUR_PRODUCTION_BUCKET
R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# ─── App ────────────────────────────────────────
VITE_SITE_URL=https://yourdomain.com
NODE_ENV=production
PORT=3001

# ─── Monitoring ─────────────────────────────────
VITE_BETTERSTACK_SOURCE_TOKEN=YOUR_BETTERSTACK_TOKEN
BETTERSTACK_SOURCE_TOKEN=YOUR_BETTERSTACK_TOKEN

